# ---------- Generative AI (any OpenAI-compatible API; leave key blank to use the built-in demo planner) ----------
# Groq (free tier, Llama-3):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_TIMEOUT=60
